{
  "name": "deathatlas",
  "version": "1.0.0",
  "description": "Global mortality dashboards, ranking index, and comparative analysis tool for all 195 sovereign nations in 2025",
  "author": "BanguDevClub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BanguDevClub/deathatlas.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,css}\" \"*.{mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,astro,css}\" \"*.{mjs,json,md}\"",
    "data:generate": "python3 scripts/generate_data.py && mkdir -p public/data && cp src/data/deaths-2025.json public/data/deaths-2025.json",
    "assets:generate": "python3 scripts/generate_assets.py",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "clean": "rm -rf dist .astro"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "astro": "^5.18.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
