---
import { Shield, Activity, ExternalLink } from "lucide-react";

const currentYear = 2026;
---

<footer class="border-t border-border bg-card/40 backdrop-blur-sm mt-20 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand & Mission -->
      <div class="md:col-span-2 flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <div class="size-8 rounded-lg bg-gradient-to-br from-sky-400 via-indigo-500 to-purple-600 flex items-center justify-center shadow-sm">
            <Activity className="size-4 text-white stroke-[2.5]" />
          </div>
          <span class="font-bold text-lg tracking-tight font-mono">
            Death<span class="text-primary font-black">Atlas</span>
          </span>
          <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
            Open Source
          </span>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed max-w-md">
          A scientific mortality analytics dashboard, ranking index, and
          scenario compare tool built by{" "}
          <strong class="text-foreground">BanguDevClub</strong>. Informing
          humanity on how societies live, heal, and pass away across 195
          countries in 2025.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://github.com/BanguDevClub/deathatlas"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-md border border-border bg-card hover:bg-accent text-card-foreground transition-colors"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-3.5"
              aria-hidden="true"
            >
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
            </svg>
            GitHub Repository
            <ExternalLink className="size-3 opacity-60" />
          </a>
          <span class="text-xs text-muted-foreground flex items-center gap-1">
            <Shield className="size-3.5 text-emerald-500" /> MIT Licensed
          </span>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="flex flex-col gap-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-foreground font-mono">
          Exploration
        </h4>
        <ul class="flex flex-col gap-2 text-sm text-muted-foreground">
          <li>
            <a href="/deathatlas/" class="hover:text-primary transition-colors">
              Overview
            </a>
          </li>
          <li>
            <a
              href="/deathatlas/dashboard"
              class="hover:text-primary transition-colors"
            >
              Dashboard
            </a>
          </li>
          <li>
            <a
              href="/deathatlas/continents"
              class="hover:text-primary transition-colors"
            >
              Continents
            </a>
          </li>
          <li>
            <a
              href="/deathatlas/ranking"
              class="hover:text-primary transition-colors"
            >
              Ranking & Scores
            </a>
          </li>
          <li>
            <a
              href="/deathatlas/compare"
              class="hover:text-primary transition-colors"
            >
              Compare Countries
            </a>
          </li>
          <li>
            <a
              href="/deathatlas/sandbox"
              class="hover:text-primary transition-colors"
            >
              Sandbox Simulator
            </a>
          </li>
          <li>
            <a
              href="/deathatlas/methodology"
              class="hover:text-primary transition-colors"
            >
              Methodology & Math
            </a>
          </li>
        </ul>
      </div>

      <!-- Scientific Sources & Governance -->
      <div class="flex flex-col gap-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-foreground font-mono">
          Data Sources (2025)
        </h4>
        <ul class="flex flex-col gap-2 text-xs text-muted-foreground">
          <li class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-sky-500"></span>
            <span>UN Population Division (WPP 2024/2025)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-indigo-500"></span>
            <span>WHO Global Health Estimates (GHE)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-purple-500"></span>
            <span>IHME Global Burden of Disease (GBD)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-amber-500"></span>
            <span>ACLED & UN OCHA Conflict Monitors</span>
          </li>
        </ul>
        <p class="text-[11px] text-muted-foreground mt-2 leading-relaxed">
          Countries with disrupted civil registration (CRVS) display explicit
          estimation banners.
        </p>
      </div>
    </div>

    <!-- Bottom credits -->
    <div class="border-t border-border mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
      <p>
        © {currentYear} Death Atlas — Built with precision by{" "}
        <a
          href="https://github.com/BanguDevClub"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-foreground hover:underline"
        >
          BanguDevClub
        </a>
        .
      </p>
      <p class="flex items-center gap-1.5">
        Death is inevitable; preventable and violent death is not.
      </p>
    </div>
  </div>
</footer>
